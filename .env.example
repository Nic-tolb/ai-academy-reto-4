# Reto 4 · copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# Servidor
PORT=8787
# URL pública con la que se abre el sitio (se usa en el enlace del aviso y para cookies Secure si es https)
PUBLIC_URL=http://localhost:8787
DATABASE_FILE=data/ai-academy.db

# n8n: URL de producción del webhook y secreto compartido (mínimo 16 caracteres).
# El mismo secreto debe estar en la variable N8N_WEBHOOK_SECRET del contenedor de n8n.
N8N_WEBHOOK_URL=http://localhost:5690/webhook/ai-academy-lead
N8N_WEBHOOK_SECRET=cambia-este-secreto-por-uno-aleatorio

# Propietario de la instancia local de n8n (solo para entrar al editor de n8n)
N8N_OWNER_EMAIL=owner@aiacademy.test
N8N_OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Telegram (los usa n8n, no el servidor). Van en .env.telegram, que tampoco se sube:
# TELEGRAM_BOT_TOKEN=123456:ABC...   (token de @BotFather)
# TELEGRAM_CHAT_ID=123456789         (chat privado de prueba; ver README)
