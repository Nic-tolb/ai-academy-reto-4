---
/**
 * Logo oficial (archivo extraído del manual, sin modificar).
 * - Zona de protección: x = altura de «ACADEMY» libre en los 4 lados.
 * - Tamaño mínimo: vertical 120 px; horizontal 160 px.
 * - Sin efectos, rotaciones ni recoloreado (no se anima).
 */
import { Image } from 'astro:assets';
import vertical from '../assets/brand/logo-principal-vertical.png';
import horizontal from '../assets/brand/logo-horizontal-blanca.png';
import { clearSpaceFor, LOGO_RULES, type LogoVariant } from '../data/brand';

interface Props {
  variant: LogoVariant;
  width: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { variant, width, loading = 'lazy', class: className } = Astro.props;
const src = variant === 'vertical' ? vertical : horizontal;
const { minWidth } = LOGO_RULES[variant];
if (width < minWidth) {
  throw new Error(`Logo ${variant}: ${width}px es menor que el mínimo de ${minWidth}px.`);
}
const height = Math.round((width * src.height) / src.width);
const clearSpace = clearSpaceFor(variant, height);
---

<span class:list={['logo', className]} style={`--clear:${clearSpace}px`} data-variant={variant}>
  <Image
    src={src}
    alt="Campuslands AI Academy"
    width={width}
    densities={[1, 2]}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : 'auto'}
    format="webp"
  />
</span>

<style lang="scss">
  .logo {
    display: inline-block;
    // La zona de protección se reserva como relleno real: nada puede invadirla.
    padding: var(--clear);
    line-height: 0;
  }
</style>
