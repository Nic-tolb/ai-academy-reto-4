---
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import Recommender from './Recommender.astro';
import { ctaLabel, MAX_HOURS, STAGES, TRACKS } from '../data/missions';
import { LINKS } from '../data/links';
---

<Section phaseId="planes" halo="tr">
  <SectionHead phaseId="planes">
    <Fragment slot="title">
      Elige tu <em>misión</em>.
    </Fragment>
    Tres etapas en vivo que se suman una sobre otra, y dos trayectorias aparte: una a la medida de
    tu empresa y otra a tu ritmo.
  </SectionHead>

  <div class="grid">
    <Recommender />

    <div>
      <p class="group-label">Etapas en vivo · cada una incluye la anterior</p>
      <ol class="stages" data-stages>
        {STAGES.map((m, i) => {
          const own = (m.hours ?? 0) - (i === 0 ? 0 : (STAGES[i - 1]?.hours ?? 0));
          const inherited = (m.hours ?? 0) - own;
          return (
            <li class="stage" id={`mision-${m.id}`} data-mission={m.id} data-stage>
              <span class="pill badge" data-badge hidden>
                Recomendada para ti
              </span>
              <div class="stage-head">
                <span class="step-num" aria-hidden="true">
                  {i + 1}
                </span>
                <div class="titles">
                  <p class="code">{m.stage}</p>
                  <h3>{m.name}</h3>
                </div>
                <p class="hours-num">
                  <strong>{m.hours}</strong>horas
                </p>
              </div>
              <div
                class="hours"
                role="img"
                aria-label={
                  inherited
                    ? `${m.hours} horas: ${inherited} de la etapa anterior y ${own} propias`
                    : `${m.hours} horas`
                }
              >
                {Array.from({ length: MAX_HOURS }, (_, h) => (
                  <i
                    class:list={[
                      { inh: h < inherited, own: h >= inherited && h < inherited + own },
                    ]}
                  />
                ))}
              </div>
              <ul class="incl">
                {m.includes.map((item, k) => (
                  <li class:list={[{ inherit: k === m.inheritedIndex }]}>{item}</li>
                ))}
              </ul>
              <a class="btn btn--secondary" href={LINKS.inscripcion}>
                {ctaLabel(m)}
              </a>
            </li>
          );
        })}
      </ol>
      <p class="legend" aria-hidden="true">
        <span>Horas propias de la etapa</span>
        <span class="inh">Horas de la etapa anterior</span>
      </p>

      <div class="tracks">
        {TRACKS.map((m) => (
          <article class="track" id={`mision-${m.id}`} data-mission={m.id} data-reveal>
            <span class="pill badge" data-badge hidden>
              Recomendada para ti
            </span>
            <div>
              <p class="code">{m.stage}</p>
              <h3>{m.name}</h3>
              <p class="track-dur">{m.duration}</p>
            </div>
            <ul class="incl">
              {m.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="track-actions">
              {m.channel === 'whatsapp' ? (
                <>
                  <a class="btn btn--primary" href={LINKS.whatsapp} target="_blank" rel="noopener">
                    {ctaLabel(m)}
                  </a>
                  <a class="btn btn--secondary" href={LINKS.inscripcion}>
                    Inscríbete
                  </a>
                </>
              ) : (
                <a class="btn btn--secondary" href={LINKS.inscripcion}>
                  {ctaLabel(m)}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Section>

<style lang="scss">
  .grid {
    display: grid;
    gap: 48px;
    @include up(xl) {
      grid-template-columns: 5fr 7fr;
      gap: 56px;
      align-items: start;
    }
  }
  .group-label {
    @include label;
    color: var(--muted);
    margin-bottom: 16px;
    line-height: 1.5;
  }
  .stages {
    display: grid;
    gap: 12px;
  }
  .stage,
  .track {
    position: relative;
    border-radius: 24px;
    padding: 24px;
    display: grid;
    gap: 18px;
    align-content: start;
    transition: box-shadow 0.3s;
    scroll-margin-top: calc(var(--header-h) + var(--phasebar-h) + 32px);
    &:global(.is-recommended) {
      box-shadow: inset 0 0 0 2px var(--electric);
    }
    .btn {
      justify-self: start;
    }
  }
  .stage {
    background: var(--card);
  }
  .track {
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .badge {
    position: absolute;
    top: -12px;
    left: 20px;
  }
  .stage-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .titles {
    flex: 1;
    min-width: 0;
  }
  .code {
    @include label;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    line-height: 1.5;
  }
  h3 {
    font-size: 1.625rem;
    letter-spacing: -0.01em;
  }
  .hours-num {
    text-align: right;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.1;
    strong {
      display: block;
      color: var(--white);
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
  }
  .hours {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 3px;
    i {
      height: 8px;
      border-radius: 2px;
      background: var(--line);
      transform-origin: left;
    }
    .inh {
      background: var(--line-strong);
    }
    .own {
      background: var(--electric);
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 12px;
    color: var(--muted);
    font-size: 0.75rem;
    span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      &::before {
        content: '';
        width: 10px;
        height: 6px;
        border-radius: 2px;
        background: var(--electric);
      }
      &.inh::before {
        background: var(--line-strong);
      }
    }
  }
  .incl {
    display: grid;
    gap: 8px;
    font-size: 0.9375rem;
    li {
      position: relative;
      padding-left: 22px;
      &::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        box-shadow: inset 0 0 0 2px var(--soft);
      }
    }
    .inherit {
      color: var(--white);
      font-weight: 500;
    }
  }
  .tracks {
    display: grid;
    gap: 12px;
    margin-top: 28px;
    @include up(sm) {
      grid-template-columns: 1fr 1fr;
    }
  }
  .track-dur {
    color: var(--white);
    font-weight: 700;
    margin-top: 2px;
  }
  .track-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
