---
import Icon from './Icon.astro';
import { LINKS } from '../data/links';
import { phase } from '../data/phases';
import { PROFILES } from '../data/profiles';

const p = phase('tripulacion');
---

<section
  class="section hero"
  id={p.id}
  data-phase
  data-phase-code={p.code}
  data-phase-name={p.name}
  aria-labelledby="hero-title"
  data-hero
>
  <!-- Campo de trayectorias (canvas). Si no carga, la página funciona igual. -->
  <canvas class="field" aria-hidden="true" data-field></canvas>
  <span class="halo halo--bl" aria-hidden="true"></span>

  <div class="wrap grid">
    <div class="copy">
      <span class="pill">{p.code} · {p.name}</span>
      <h1 id="hero-title">Evoluciona a la <em>velocidad</em> de la tecnología.</h1>
      <p class="lead" data-hero-lead aria-live="polite">
        En Campuslands AI Academy aprendes IA con tus tareas reales y sales con un banco de prompts,
        guías y agentes listos para tu trabajo.
      </p>

      <fieldset class="crew">
        <legend>¿Quién va en esta misión?</legend>
        <div class="crew-options">
          {
            PROFILES.map((p) => (
              <button type="button" class="crew-opt" data-profile={p.id} aria-pressed="false">
                {p.label}
              </button>
            ))
          }
        </div>
      </fieldset>

      <!-- Respuesta inmediata a la elección: misión sugerida -->
      <a class="mission-chip" href="#planes" data-mission-chip hidden>
        <span class="chip-label">Tu trayectoria</span>
        <span class="chip-name" data-chip-name></span>
        <span class="chip-meta" data-chip-meta></span>
        <Icon name="arrow" class="chip-arrow" />
      </a>

      <div class="ctas">
        <a class="btn btn--primary" href="#planes">Ver planes <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--secondary" href={LINKS.whatsapp} target="_blank" rel="noopener" data-hero-cta2>
          Hablar con un especialista
        </a>
      </div>
    </div>
  </div>

  <p class="hint" aria-hidden="true" data-field-hint>Mueve el cursor o toca para desviar la trayectoria</p>
</section>

<style lang="scss">
  .hero {
    min-height: calc(100svh - var(--header-h) - var(--phasebar-h));
    display: flex;
    align-items: center;
    padding-block: 32px 72px;
    @include up(lg) {
      padding-block: 48px 112px;
    }
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    touch-action: pan-y; // nunca bloquea el scroll en celulares
  }
  .grid {
    position: relative;
  }
  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
    max-width: 40rem;
    @include up(lg) {
      max-width: 58%;
    }
  }
  h1 {
    font-size: var(--fs-display);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 15ch;
  }
  .lead {
    font-size: var(--fs-lead);
    max-width: 34rem;
    min-height: 4.65em; // evita saltos al cambiar el texto según el perfil
  }
  .crew {
    border: 0;
    padding: 0;
    min-width: 0;
    legend {
      color: var(--white);
      font-weight: 600;
      margin-bottom: 12px;
      padding: 0;
    }
  }
  .crew-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .crew-opt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: rgb(5 5 7 / 0.7);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--body);
    transition:
      background-color 0.16s,
      box-shadow 0.16s,
      color 0.16s,
      transform 0.16s var(--ease);
    &::before {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      box-shadow: inset 0 0 0 1px var(--muted);
      transition: background-color 0.16s;
    }
    @include hover {
      box-shadow: inset 0 0 0 1px var(--soft);
      color: var(--white);
    }
    &:active {
      transform: scale(0.97);
    }
    &[aria-pressed='true'] {
      background: rgb(112 38 232 / 0.35);
      box-shadow: inset 0 0 0 1px var(--soft);
      color: var(--white);
      &::before {
        background: var(--soft);
        box-shadow: none;
      }
    }
  }

  .mission-chip {
    display: inline-grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: 4px 12px;
    padding: 12px 16px 12px 18px;
    border-radius: 16px;
    background: rgb(5 5 7 / 0.8);
    box-shadow: inset 0 0 0 1px var(--electric);
    text-decoration: none;
    color: var(--white);
    @include motion {
      animation: chip-in 0.4s var(--ease);
    }
    @include hover {
      background: rgb(112 38 232 / 0.25);
    }
  }
  .chip-label {
    @include label;
    font-size: 0.6875rem;
    color: var(--soft);
  }
  .chip-name {
    font-weight: 800;
    font-size: 1.125rem;
  }
  .chip-meta {
    color: var(--body);
    font-size: 0.875rem;
  }
  .mission-chip :global(.chip-arrow) {
    width: 18px;
    height: 18px;
    color: var(--soft);
  }
  @include down(sm) {
    .mission-chip {
      grid-template-columns: auto 1fr auto;
    }
    .chip-label {
      grid-column: 1 / -1;
    }
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    .btn {
      flex: 1 1 auto;
      @include up(sm) {
        flex: 0 0 auto;
      }
    }
  }

  .hint {
    position: absolute;
    right: var(--gutter);
    bottom: 24px;
    font-size: 0.8125rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.4s;
    &:global(.is-visible) {
      opacity: 1;
    }
    @include down(lg) {
      display: none;
    }
  }
</style>
