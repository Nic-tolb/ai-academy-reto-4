---
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import { BENEFITS } from '../data/content';
---

<Section phaseId="beneficios" halo="bl">
  <SectionHead phaseId="beneficios">
    <Fragment slot="title">Lo que te llevas de cada <em>misión</em>.</Fragment>
    Por qué elegir Campuslands AI Academy.
  </SectionHead>
  <ul class="cards">
    {
      BENEFITS.map((b) => (
        <li class="card" data-reveal>
          <span class="label">{b.tag}</span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style lang="scss">
  .cards {
    display: grid;
    gap: 16px;
    @include up(md) {
      grid-template-columns: 1fr 1fr;
    }
    @include up(xl) {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
