---
import { PHASES } from '../data/phases';
---

<nav class="phase-rail" aria-label="Plan de vuelo">
  <span class="fill" aria-hidden="true" data-rail-fill></span>
  <ol>
    {PHASES.map((p) => (
      <li>
        <a href={`#${p.id}`} data-phase-link>
          <span class="tick" aria-hidden="true" />
          <span class="code">{p.code}</span>
          <span class="name">{p.name}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style lang="scss">
  .phase-rail {
    display: none;
    @include up(rail) {
      display: block;
      position: fixed;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 40;
      // Fondo propio: los filetes entre secciones no cruzan el riel.
      padding: 14px 14px 14px 8px;
      border-radius: 16px;
      background: var(--black);
    }
  }
  ol {
    position: relative;
    display: grid;
    gap: 18px;
  }
  ol::before,
  .fill {
    content: '';
    position: absolute;
    left: 13px;
    top: 22px;
    bottom: 22px;
    width: 1px;
    background: var(--line);
  }
  ol::before {
    left: 5px;
    top: 8px;
    bottom: 8px;
  }
  // T−0 · Despegue: el punto al que lleva toda la cuenta regresiva.
  li:last-child a {
    .tick {
      box-shadow: inset 0 0 0 2px var(--evox);
    }
    .code {
      color: var(--soft);
    }
    &:global(:not([aria-current='step'])) .tick {
      background: rgb(112 38 232 / 0.35);
    }
  }
  .fill {
    z-index: 1;
    width: 2px;
    margin-left: -0.5px;
    background: var(--electric);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
    transition: transform 0.5s var(--ease);
  }
  li {
    position: relative;
    z-index: 2;
  }
  a {
    @include label;
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 2px 0;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-decoration: none;
    &:hover {
      color: var(--white);
    }
    &:global(.is-past) .tick {
      background: var(--electric);
      box-shadow: none;
    }
    &[aria-current='step'] {
      color: var(--white);
      .tick {
        background: var(--soft);
        box-shadow: 0 0 0 4px rgb(183 131 255 / 0.2);
      }
    }
  }
  .tick {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--black);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .code {
    min-width: 3.2em;
    font-variant-numeric: tabular-nums;
  }
  // El nombre aparece al pasar el cursor o con foco, sin tapar el contenido.
  .name {
    position: absolute;
    left: 100%;
    margin-left: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--black);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s,
      transform 0.2s var(--ease);
  }
  a:hover .name,
  a:focus-visible .name {
    opacity: 1;
    transform: none;
  }
</style>
