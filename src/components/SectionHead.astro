---
/** Encabezado de fase: píldora con el código de la cuenta regresiva + titular. */
import { phase, type PhaseId } from '../data/phases';

interface Props {
  phaseId: PhaseId;
}
const p = phase(Astro.props.phaseId);
---

<div class="section-head" data-reveal>
  <span class="pill">{p.code} · {p.name}</span>
  <h2 id={`${p.id}-title`}><slot name="title" /></h2>
  {Astro.slots.has('default') && <p><slot /></p>}
</div>
