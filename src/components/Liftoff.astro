---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import Icon from './Icon.astro';
import maxPresentando from '../assets/brand/max-pose-presentando.png';
import { LINKS } from '../data/links';
import { phase } from '../data/phases';
const p = phase('despegue');
---

<Section phaseId="despegue">
  <div class="block" data-reveal>
    <div class="copy">
      <span class="pill">
        {p.code} · {p.name}
      </span>
      <h2 id={`${p.id}-title`}>Tu misión empieza con una decisión.</h2>
      <p>
        Inscríbete en la etapa que elegiste o cuéntale a un especialista qué necesita tu equipo.
      </p>
      <div class="ctas">
        <a class="btn btn--light" href={LINKS.inscripcion}>
          Inscríbete
        </a>
        <a class="btn btn--outline" href={LINKS.whatsapp} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Hablar con un especialista
        </a>
      </div>
    </div>
    <Image src={maxPresentando} alt="" width={260} densities={[1, 2]} format="webp" class="max" />
  </div>
</Section>

<style lang="scss">
  .block {
    position: relative;
    display: grid;
    gap: 24px;
    align-items: end;
    background: var(--evox);
    border-radius: 28px;
    padding: 40px 24px 0;
    overflow: hidden;
    @include up(md) {
      grid-template-columns: 1fr auto;
      padding: 64px 64px 0;
    }
  }
  .copy {
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-bottom: 40px;
    @include up(md) {
      padding-bottom: 64px;
    }
  }
  h2 {
    font-size: var(--fs-h2);
    max-width: 16ch;
  }
  p {
    color: var(--white);
    font-size: var(--fs-lead);
    max-width: 36rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn--outline {
    color: var(--white);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.6);
    @include hover {
      background: rgb(255 255 255 / 0.12);
    }
  }
  .max {
    width: 180px;
    justify-self: end;
    margin-bottom: -8px;
    @include up(md) {
      width: 260px;
    }
  }
</style>
